# Copy to `.env` and fill in. Never commit the real .env.
# The app reads .env from this repo's folder first, then from the folder above it
# (e.g. the course's submissions/.env with the teaching staff's keys).

# REQUIRED — Portkey key for gpt-6-luna (the only model and the only key this app uses)
PORTKEY_API_KEY=

# OPTIONAL — built-in management login for #/staff (managers can also just sign up in the app)
ADMIN_USERNAME=staff
ADMIN_PASSWORD=change-me

# OPTIONAL
FOUNDATION_RFC=
PRICE_INPUT_PER_1M=0.10
PRICE_OUTPUT_PER_1M=0.50
PRICE_CACHED_INPUT_PER_1M=0.01
