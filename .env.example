# Copy to `.env` (same folder) and fill in. Never commit the real .env.

# Portkey key for gpt-6-luna (the only model this app uses)
PORTKEY_API_KEY=

# Built-in management login for the dashboard (#/staff); managers can also sign up in the app
ADMIN_USERNAME=staff
ADMIN_PASSWORD=change-me

# Optional
FOUNDATION_RFC=
PRICE_INPUT_PER_1M=0.10
PRICE_OUTPUT_PER_1M=0.50
